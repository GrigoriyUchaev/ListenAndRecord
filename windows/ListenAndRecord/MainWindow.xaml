<Window x:Class="ListenAndRecord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ListenAndRecord" Width="780" Height="800" MinWidth="660" MinHeight="560"
        Icon="Assets/AppIcon.ico" Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <TabControl x:Name="Tabs" Margin="10" Padding="8" Background="#F4F5F7" BorderThickness="0">

        <!-- ================= RECORD ================= -->
        <TabItem Header="  ● Запись  " FontSize="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Готово к записи" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TimerText" Text="00:00:00" FontFamily="Consolas" FontSize="56" FontWeight="Light"
                                       HorizontalAlignment="Center" Margin="0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Content="●  Начать запись" MinWidth="200" Click="Start_Click"/>
                                <Button x:Name="PauseButton" Content="❚❚  Пауза" MinWidth="150" Margin="0,0,10,0" Click="Pause_Click" Visibility="Collapsed" FontSize="14"/>
                                <Button x:Name="StopButton" Style="{StaticResource AccentButton}" Content="■  Стоп" MinWidth="150" Click="Stop_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Что записывать" Style="{StaticResource Header}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="MicCheck" Content="Мой микрофон" Margin="0,0,24,0" Checked="Sources_Changed" Unchecked="Sources_Changed"/>
                                <CheckBox x:Name="SysCheck" Content="Звук созвона (голоса собеседников)" Checked="Sources_Changed" Unchecked="Sources_Changed"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="🎤  Микрофон" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="MicMeter" Grid.Column="1" Maximum="1" Margin="0,6"/>
                                <TextBlock Grid.Row="1" Text="🔊  Звук созвона" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="SysMeter" Grid.Row="1" Grid.Column="1" Maximum="1" Margin="0,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SaveCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Сохранение записи" Style="{StaticResource Header}"/>
                            </DockPanel>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Имя файла:" VerticalAlignment="Center"/>
                                <TextBox x:Name="FileNameBox" Grid.Column="1" Padding="4" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Text="Формат:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="FormatCombo" Grid.Row="1" Grid.Column="1" Margin="0,4" MaxWidth="420" HorizontalAlignment="Left" MinWidth="340"
                                          SelectionChanged="Format_Changed"/>
                            </Grid>
                            <ProgressBar x:Name="ExportProgress" Maximum="1" Margin="0,8" Visibility="Collapsed"/>
                            <DockPanel x:Name="SaveButtons" Margin="0,8,0,0">
                                <Button x:Name="DiscardButton" DockPanel.Dock="Right" Content="Удалить запись" Click="Discard_Click"/>
                                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="💾  Сохранить…" HorizontalAlignment="Left" Click="Save_Click"/>
                            </DockPanel>
                            <StackPanel x:Name="SavedPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock x:Name="SavedText" TextWrapping="Wrap" Foreground="#15803D"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Показать в папке" Click="ShowSaved_Click" Margin="0,0,8,0"/>
                                    <Button Content="Расшифровать эту запись" Click="TranscribeSaved_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ErrorCard" Style="{StaticResource Card}" Visibility="Collapsed" Background="#FFF7ED" BorderBrush="#FDBA74">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Скрыть" Click="HideError_Click" VerticalAlignment="Top"/>
                            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#9A3412"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Margin="4,4,4,0">
                        <TextBlock Style="{StaticResource Hint}" Text="• Работает с любым приложением: Zoom, Teams, Telegram, Discord, WhatsApp, Google Meet в браузере."/>
                        <TextBlock Style="{StaticResource Hint}" Text="• Лучше говорить в наушниках — тогда голоса собеседников не попадут в микрофон повторно (без эха)."/>
                        <TextBlock Style="{StaticResource Hint}" Text="• Горячие клавиши работают из любого окна: Ctrl+Alt+R — начать, Ctrl+Alt+P — пауза/продолжить, Ctrl+Alt+S — стоп."/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= TRANSCRIBE ================= -->
        <TabItem x:Name="TranscribeTab" Header="  Расшифровка  " FontSize="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <Border x:Name="NoModelCard" Style="{StaticResource Card}" Background="#FFF7ED" BorderBrush="#FDBA74" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Открыть «Модели»" Click="OpenModels_Click"/>
                            <TextBlock Text="Не выбрана модель распознавания — скачайте её (один раз) на вкладке «Модели и настройки»."
                                       TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#9A3412"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Аудиофайл" Style="{StaticResource Header}"/>
                            <Border x:Name="DropArea" BorderBrush="#C7CCD4" BorderThickness="1.5" CornerRadius="8" Padding="12" AllowDrop="True"
                                    Background="#FAFBFC" Drop="DropArea_Drop" DragOver="DropArea_DragOver">
                                <DockPanel>
                                    <Button x:Name="ChooseFileButton" DockPanel.Dock="Right" Content="Выбрать файл…" Click="ChooseFile_Click" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="FileText" Text="Перетащите сюда аудио- или видеофайл" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="FileInfoText" Text="M4A, MP3, WAV, WMA, MP4…" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="OptionsCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Параметры" Style="{StaticResource Header}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Язык разговора:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="280" HorizontalAlignment="Left" Margin="0,4" SelectionChanged="Language_Changed"/>
                                <TextBlock Grid.Row="1" Text="Модель:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ModelCombo" Grid.Row="1" Grid.Column="1" Width="280" HorizontalAlignment="Left" Margin="0,4" SelectionChanged="Model_Changed"/>
                                <TextBlock Grid.Row="2" Text="Формат файла:" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                                    <RadioButton x:Name="DocxRadio" Content="DOCX — документ Word" GroupName="fmt" Checked="TranscriptFormat_Changed"/>
                                    <RadioButton x:Name="TxtRadio" Content="TXT — простой текст" GroupName="fmt" Margin="0,4,0,0" Checked="TranscriptFormat_Changed"/>
                                </StackPanel>
                                <CheckBox x:Name="TimestampsCheck" Grid.Row="3" Grid.Column="1" Content="Добавлять время начала абзацев [чч:мм:сс]" Margin="0,4"
                                          Checked="Timestamps_Changed" Unchecked="Timestamps_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Распознавание идёт на этом компьютере, без интернета." Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TranscribeButton" Style="{StaticResource AccentButton}" Content="Расшифровать" MinWidth="180" Click="Transcribe_Click"/>
                                    <Button x:Name="CancelButton" Content="Отменить" Margin="10,0,0,0" Visibility="Collapsed" Click="Cancel_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <DockPanel>
                                    <TextBlock x:Name="EtaText" DockPanel.Dock="Right" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="StageText"/>
                                </DockPanel>
                                <ProgressBar x:Name="TranscribeProgress" Maximum="1" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TranscribeError" Foreground="#C2410C" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="WordsText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="Результат" Style="{StaticResource Header}"/>
                            </DockPanel>
                            <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap" Height="320" VerticalScrollBarVisibility="Auto" Padding="8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SaveTranscriptButton" Style="{StaticResource AccentButton}" Content="💾  Сохранить…" Click="SaveTranscript_Click"/>
                                <Button Content="Копировать текст" Margin="10,0,0,0" Click="Copy_Click"/>
                                <Button x:Name="ShowTranscriptButton" Content="Показать в папке" Margin="10,0,0,0" Visibility="Collapsed" Click="ShowTranscript_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= MODELS & SETTINGS ================= -->
        <TabItem x:Name="ModelsTab" Header="  Модели и настройки  " FontSize="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Этот компьютер" Style="{StaticResource Header}"/>
                            <TextBlock x:Name="HardwareText" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RecommendationText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#15803D"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Добавить свой файл модели…" Click="ImportModel_Click"/>
                                <TextBlock Text="Модели распознавания речи" Style="{StaticResource Header}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Распознаватель встроен в приложение и работает без интернета. Интернет нужен только один раз — чтобы скачать модель."/>
                            <StackPanel x:Name="ModelsList"/>
                            <TextBlock x:Name="ModelsError" Foreground="#C2410C" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Качество и защита от пропусков" Style="{StaticResource Header}"/>
                            <RadioButton x:Name="AccurateRadio" Content="Максимальная точность (beam search)" GroupName="acc" Checked="Accuracy_Changed"/>
                            <RadioButton x:Name="FastRadio" Content="Быстрее (немного менее точно) — для слабых компьютеров" GroupName="acc" Margin="0,4,0,10" Checked="Accuracy_Changed"/>
                            <CheckBox x:Name="VadCheck" Content="Удалять тишину детектором речи Silero VAD" Checked="Vad_Changed" Unchecked="Vad_Changed"/>
                            <DockPanel Margin="20,4,0,8">
                                <Button x:Name="VadDownloadButton" DockPanel.Dock="Right" Content="Скачать (≈1 МБ)" Click="DownloadVad_Click"/>
                                <TextBlock x:Name="VadStatus" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                            </DockPanel>
                            <CheckBox x:Name="RecoverCheck" Content="Проверять результат и повторно распознавать фрагменты, где речь потерялась"
                                      Checked="Recover_Changed" Unchecked="Recover_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Как приложение избегает «потери» разговора после пауз:&#x0a;• запись режется на фрагменты по паузам, длинная тишина вырезается;&#x0a;• каждый фрагмент распознаётся независимо, без «памяти» предыдущего текста — именно из-за неё Whisper зацикливается и пропускает речь;&#x0a;• после распознавания проверяется, не осталось ли участков речи без текста; такие участки распознаются повторно мелкими кусками;&#x0a;• удаляются типичные «галлюцинации» в тишине («Продолжение следует…», «Субтитры сделал…», повторы)."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Если не записывается микрофон" Style="{StaticResource Header}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Откройте Параметры Windows → Конфиденциальность → Микрофон и включите «Разрешить классическим приложениям доступ к микрофону»."/>
                            <Button Content="Открыть настройки микрофона" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenMicPrivacy_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
